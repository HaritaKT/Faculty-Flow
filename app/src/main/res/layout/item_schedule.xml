<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AppleCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="14dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <!-- Time column -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStartTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:00"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="@color/apple_label"
                android:textSize="15sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvEndTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:00"
                android:textColor="@color/apple_tertiary_label"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Colour accent bar — tinted by adapter -->
        <View
            android:id="@+id/statusIndicator"
            android:layout_width="4dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/rounded_button" />

        <!-- Subject name + room -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvClassName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data Structures"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
                android:textColor="@color/apple_label"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvClassRoom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Room 301 · Block A"
                android:textColor="@color/apple_secondary_label"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Status chip -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="IN CLASS"
            android:textSize="10sp"
            android:fontFamily="sans-serif-condensed"
                android:textStyle="bold"
            android:letterSpacing="0"
            android:maxLines="1" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>